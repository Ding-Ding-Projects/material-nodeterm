{
  "name": "node-terminal",
  "version": "0.4.3",
  "description": "node-based terminal manager — multiple draggable, zoomable terminals on a single canvas.",
  "author": {
    "name": "enes",
    "email": "eneskirca@gmail.com"
  },
  "license": "BUSL-1.1",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/check-vocabulary.mjs && node scripts/check-material-audit.mjs && node scripts/check-personal-vocabulary-coverage.mjs && node scripts/check-changelog.mjs && node scripts/check-docs-bundle.mjs && node scripts/check-uh-inventory.mjs && npm run build:app",
    "build:app": "electron-vite build && npm run host:build",
    "build-changelog": "node scripts/build-changelog.mjs",
    "check-changelog": "node scripts/check-changelog.mjs",
    "build-docs": "node scripts/build-docs-bundle.mjs",
    "check-docs": "node scripts/check-docs-bundle.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && node scripts/check-paste-frame-parity.mjs",
    "test": "vitest run",
    "test:unit": "vitest run test/remote",
    "rebuild": "node scripts/check-build-preflight.mjs && node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty,smart-whisper",
    "server:build": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=out/server/main.cjs --external:node-pty --external:ws --external:smart-whisper --tsconfig=tsconfig.node.json",
    "server:start": "node out/server/main.cjs",
    "server:dev": "npm run build && npm run server:build && node out/server/main.cjs",
    "host:build": "esbuild src/session-host/host.ts --bundle --platform=node --format=cjs --outfile=out/session-host/host.cjs --external:node-pty --tsconfig=tsconfig.node.json",
    "shots": "node scripts/capture-shots.mjs",
    "shots:sync": "node scripts/sync-pr-gallery.mjs",
    "check:wired": "node scripts/check-app-wired.mjs",
    "make-social-card": "node scripts/make-social-card.mjs",
    "record-app": "node scripts/record-app.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "make-social": "node scripts/make-social.mjs",
    "count-lines": "node scripts/count-lines.mjs",
    "check:app-contract": "node scripts/check-app-contract.mjs",
    "check:material-audit": "node scripts/check-material-audit.mjs",
    "check:vocabulary-coverage": "node scripts/check-personal-vocabulary-coverage.mjs",
    "check:mirror": "node scripts/check-instruction-mirror.mjs",
    "check:uh-inventory": "node scripts/check-uh-inventory.mjs",
    "check:site-contract": "node scripts/check-site-contract.mjs",
    "dist": "npm run make-icon && npm run build && electron-builder --mac --arm64 --publish never -c.mac.identity=null -c.mac.notarize=false -c.extraMetadata.nodeTermUpdates=disabled",
    "dist:linux": "npm run make-icon && npm run build && electron-builder --linux --publish never -c.extraMetadata.nodeTermUpdates=disabled",
    "dist:win": "node scripts/windows-installer.mjs build",
    "release": "npm run make-icon && npm run build && sh -c 'electron-builder --mac --arm64 --x64 --publish never; s=$?; npm run rebuild; exit $s'",
    "postinstall": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty,smart-whisper",
    "design:compare": "electron design/compare",
    "design:v2": "electron design/v2-preview"
  },
  "build": {
    "appId": "com.nodeterm.app",
    "productName": "nodeterm",
    "afterSign": "./scripts/windows-pe-identity.mjs",
    "beforePack": "./scripts/before-pack.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/session-host/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/smart-whisper/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "out/session-host",
        "to": "session-host"
      },
      {
        "from": "node_modules/node-pty",
        "to": "session-host/node_modules/node-pty"
      },
      {
        "from": "dist/.pack-resources/codex-relay.js",
        "to": "codex-relay.js"
      },
      {
        "from": "host.bat",
        "to": "server-deployment/host.bat"
      },
      {
        "from": "docker-compose.yml",
        "to": "server-deployment/docker-compose.yml"
      },
      {
        "from": "Dockerfile",
        "to": "server-deployment/Dockerfile"
      },
      {
        "from": ".dockerignore",
        "to": "server-deployment/.dockerignore"
      },
      {
        "from": "dist/.pack-resources/server-deployment/package.json",
        "to": "server-deployment/package.json"
      },
      {
        "from": "package-lock.json",
        "to": "server-deployment/package-lock.json"
      },
      {
        "from": "electron.vite.config.ts",
        "to": "server-deployment/electron.vite.config.ts"
      },
      {
        "from": "tsconfig.json",
        "to": "server-deployment/tsconfig.json"
      },
      {
        "from": "tsconfig.node.json",
        "to": "server-deployment/tsconfig.node.json"
      },
      {
        "from": "tsconfig.web.json",
        "to": "server-deployment/tsconfig.web.json"
      },
      {
        "from": "deploy",
        "to": "server-deployment/deploy"
      },
      {
        "from": "src",
        "to": "server-deployment/src"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "enes <eneskirca@gmail.com>"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "resources/bin/tmux",
          "to": "bin/tmux"
        },
        {
          "from": "resources/licenses",
          "to": "licenses"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "nodeterm uses the microphone so you can dictate into your terminals."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://nodeterm.dev/updates"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^12.0.2",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "smart-whisper": "^0.8.1",
    "tweetnacl": "^1.0.3",
    "unzipper": "^0.12.5",
    "ws": "^8.21.3",
    "zustand": "^4.5.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.2",
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.1",
    "jsdom": "^30.0.1",
    "material-symbols": "0.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^1.7.2",
    "sax": "^1.6.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
