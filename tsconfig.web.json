{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Path values are relative to this file's own directory, so no "baseUrl" is
    // needed to anchor them. TypeScript 7 drops "baseUrl" entirely; this form
    // resolves identically on 5.x and 7.x.
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/session-host/**/*",
    "src/preload/index.d.ts"
  ],
  "exclude": [
    "src/core/**/*.test.ts",
    "src/core/**/*.realwindows.test.ts",
    "src/session-host/**/*.test.ts"
  ]
}
