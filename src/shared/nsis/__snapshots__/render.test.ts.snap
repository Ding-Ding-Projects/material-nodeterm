// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderNsis — full realistic script snapshot > matches the expected complete .nsi output 1`] = `
"; Generated by nodeterm's NSIS core. Do not hand-edit; regenerate from the spec.
Unicode true
Name "Widget Studio"
OutFile "WidgetStudioSetup.exe"
InstallDir "$PROGRAMFILES64\\Widget Studio"
RequestExecutionLevel admin
SetCompressor lzma

VIProductVersion "2.0.4.0"
VIAddVersionKey "ProductName" "Widget Studio"
VIAddVersionKey "CompanyName" "Widgets Inc."
VIAddVersionKey "FileVersion" "2.0.4"
VIAddVersionKey "ProductVersion" "2.0.4"

Icon "build\\app.ico"
UninstallIcon "build\\app.ico"

!include "MUI2.nsh"
!insertmacro MUI_PAGE_LICENSE "LICENSE.txt"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "Install"
  SetShellVarContext all
  SetOutPath "$INSTDIR"
  File "dist\\app.exe"
  SetOutPath "$INSTDIR\\resources"
  File /r "dist\\resources\\*.*"
  CreateDirectory "$SMPROGRAMS\\Widget Studio"
  CreateShortcut "$SMPROGRAMS\\Widget Studio\\Widget Studio.lnk" "$INSTDIR\\app.exe"
  CreateShortcut "$DESKTOP\\Widget Studio.lnk" "$INSTDIR\\app.exe"
  WriteUninstaller "$INSTDIR\\Uninstall.exe"
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Widget Studio" "DisplayName" "Widget Studio"
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Widget Studio" "UninstallString" "$INSTDIR\\Uninstall.exe"
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Widget Studio" "Publisher" "Widgets Inc."
  WriteRegStr HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Widget Studio" "DisplayVersion" "2.0.4"
SectionEnd

Section "Uninstall"
  SetShellVarContext all
  RMDir /r "$INSTDIR"
  Delete "$SMPROGRAMS\\Widget Studio\\Widget Studio.lnk"
  RMDir "$SMPROGRAMS\\Widget Studio"
  Delete "$DESKTOP\\Widget Studio.lnk"
  DeleteRegKey HKLM "Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Widget Studio"
SectionEnd

"
`;
